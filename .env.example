# Database
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=indexer
DB_PORT=5432

# JungleBus (default: junglebus.gorillapool.io)
# JUNGLEBUS_SERVER=junglebus.gorillapool.io

# Start block (falls back to last indexed block if DB has data)
# START_HEIGHT=800000

# Subscription config file (alternative to SUB_* env vars)
# CONFIG=subscriptions.yaml

# Or pass subscription IDs directly:
# SUB_POST=your-subscription-id
# SUB_LIKE=your-subscription-id
# SUB_PROFILE=your-subscription-id
